# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# Where to find each value: Supabase dashboard > your project (see README "Supabase setup").
# ---------------------------------------------------------------------------

# Site origin used for canonical URLs / Open Graph / sitemap.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Dashboard > Project Settings > Data API > "Project URL"   (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard > Project Settings > API Keys > "Publishable key"   (sb_publishable_...)
# Safe for the browser: it has no privileges beyond what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dashboard > Project Settings > API Keys > "Secret keys" > default > reveal/copy   (sb_secret_...)
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never import in client code.
# (A legacy service_role key also works here if your project has not moved to the new keys.)
SUPABASE_SECRET_KEY=

# Random string; Vercel Cron sends it to /api/cron/cleanup (server only)
CRON_SECRET=
